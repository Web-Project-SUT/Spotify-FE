# Spotify-FE environment. Copy to `.env` and adjust. `.env` is gitignored.
#
# Point the frontend at the running backend to switch every screen from the
# mock localStorage layer to real API calls. LEAVE THIS UNSET (or delete the
# file) to run the app in pure mock mode with no backend — the resource layer
# falls back automatically.
#
# Must include the /api suffix.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
